<?xml version="1.0"?>
<!DOCTYPE emmaconfig SYSTEM "emma02.dtd">

<!-- bench/emma: a plain Elf for the Tiny BASIC chess benchmark - RAM from 0000
     to EFFF, as the Netronics Elf II's Tiny BASIC machine has it, and a VT100
     on Q and EF4 at 300 baud, which is that machine's terminal.  Nothing
     else: no front panel, cassette or BASIC hooks.  The image is
     bench/out/tbchess.hex, which starts itself; see bench/TinyBasicRun.java. -->

<emmaconfig>
    <system>
        <name>Elf</name>
        <config>Tiny Basic chess benchmark, serial</config>
        <clock>1.76</clock>
        <boot>0</boot>
        <init ef="1">1</init>
        <init ef="2">1</init>
        <init ef="3">1</init>
        <init ef="4">1</init>
        <dirname>Elf</dirname>
    </system>

    <memory>
        <ram type="gui">
            <start>0x0000</start>
            <end>0xEFFF</end>
            <pulldown mask="tbchess*.*">Elf</pulldown>
            <filename>tbchess.hex</filename>
        </ram>
    </memory>

    <vt type="vt100" connection="serial">
        <font>vt100.bin</font>
        <ef>4</ef>
        <q></q>
        <caps />
        <baud type="receive">300</baud>
        <baud type="transmit">300</baud>
        <border>0x0</border>
        <color type="fore">0, 255, 0</color>
        <color type="back">0, 0x40, 0</color>
        <color type="high">0, 0xff, 0</color>
    </vt>

    <debugger>
        <scrt mode="on">
            <call reg="4">0x12a</call>
            <return reg="5">0x13c</return>
        </scrt>
    </debugger>
</emmaconfig>
