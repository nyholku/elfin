<?xml version="1.0"?>
<!DOCTYPE emmaconfig SYSTEM "emma02.dtd">

<!-- Emma 02 machine definition for ElFin.

     The generic "Elf" is the target because its XML gives a free memory map
     and a terminal on ports of our choosing.  The CDP1854 is on ports 6 and
     7, data and status, where the 1802/Mini has it: that is the real machine,
     and Emma's follows it, so a program sees one terminal on both.

     Install with ../emma/run-emma.sh, which copies this and the assembled hex
     into the Emma 02 data directory.
-->

<emmaconfig>

    <system>
        <name>Elf</name>
        <config>ElFin smoke test, CDP1854 UART on ports 6 and 7</config>
        <clock>1.76</clock>
        <boot>0</boot>
        <init ef="1">1</init>
        <init ef="2">1</init>
        <init ef="3">1</init>
        <dirname>Elf</dirname>
    </system>

    <memory>
        <ram type="gui">
            <start>0x0000</start>
            <end>0xFFFF</end>
            <pulldown mask="elfin*.*">Elf</pulldown>
            <filename verify="true">elfin-video.hex</filename>
        </ram>
    </memory>

    <video type="pixie">
        <out>1</out>
        <in>1</in>
        <ef>1</ef>
        <border>33x33</border>
        <color type="fore">255, 255, 255</color>
        <color type="back">0, 0, 0</color>
    </video>

    <vt type="vt100" connection="uart1854" >
        <font>vt100.bin</font>
        <out type="register">6</out>     <!-- OUT 6: load transmitter -->
        <out type="control" thre="unchanged">7</out>      <!-- OUT 7: load control; THRE as it was -->
        <in type="register">6</in>       <!-- INP 6: read receiver    -->
        <in type="status">7</in>         <!-- INP 7: bit 0 DA, bit 7 THRE -->
        <baud type="receive">19200</baud>
        <baud type="transmit">19200</baud>
        <characters>80</characters>
        <border>0x0</border>
        <color type="fore">0, 255, 0</color>
        <color type="back">0, 0x40, 0</color>
        <color type="high">0, 0xff, 0</color>
     </vt>

    <debugger>
        <!-- off: our SCRT is the jump-table variant with a one byte index,
             not the standard two byte address, so Emma would mis-decode it. -->
        <scrt mode="off">
            <call reg="4">-1</call>
            <return reg="5">-1</return>
        </scrt>

        <assembler>
            <filename>mycode</filename>
            <code_start>0</code_start>
            <code_end>0xFFF</code_end>
        </assembler>
    </debugger>

</emmaconfig>
