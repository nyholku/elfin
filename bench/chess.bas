REM CHESS BENCHMARK IN NETRONICS TINY BASIC - A PORT OF src/elfin/chess.txt
REM
REM Same board, same move generator, same evaluation and the same negamax
REM alpha-beta, in the same move order, so it picks the same move.  What
REM it computes is bench/chess-bench.txt's: the opening position, white to
REM move, BESTMV at DEPTH 2, then the board after it.
REM
REM Written the way Tiny BASIC wants, which is what makes it a fair race:
REM GOTO and GOSUB search the program from the top, so the hot code comes
REM first and the setup last; bench/tbload.py drops these REM lines and every
REM blank outside a string, because the interpreter re-reads the text each
REM time; and the move-making the ElFin version calls is inlined.  Like the
REM ElFin version, the search never multiplies or divides: the position
REM scores are tables made by SETUP, the ply lists are one stack, and the
REM per-ply record and the move are pointers stepped along.
REM
REM There are 26 variables and no arrays, so everything else is memory:
REM   Z=24576 board, 128 bytes, 0x88 layout
REM   Y=24832 the move stack, 2 bytes a move: from, to.  A ply's list
REM           starts where the one below it ends
REM   X=25600 per-ply records, 16 bytes: +0/1 M, +2 captured,
REM           +4/5 A, +6/7 B, +8/9 BEST, +10/11 best move at the root,
REM           +12/13 W
REM   U=25856 tables: +0 VAL (2 bytes each), +16 CEN, +24 DIR+128,
REM           +32 NOFF+128, +40 piece letters, +64..+319 on-board flags
REM           indexed by square+64 (the stand-in for SQ&136, there is no AND),
REM           +320 centre score CS, +448 white pawn PW, +576 black pawn PK,
REM           each indexed by square
REM Variables are global, so the recursive search keeps its own state per
REM ply in the record, copying A (address 130), B (132), E (138), M (154)
REM and W (174) byte by byte - which also keeps negative numbers intact.
REM
REM P ply  S side 0/8  D depth left  A alpha  B beta  E best  V value
REM N this ply's record  M this move  F from  T to  K this ply's list
REM W next free  L square  Q piece  C type/temp  G target piece  H table
REM J direction  R last direction/rank  O offset  I unused
1 GOTO 9000
REM ---- GEN: moves for side S, from K up to W
100 W=K
120 L=0
130 Q=PEEK(Z+L)
140 IF Q=0 GOTO 190
150 IF Q>8 IF S=0 GOTO 190
160 IF Q<8 IF S=8 GOTO 190
170 GOSUB 300
190 L=L+1
200 IF PEEK(U+128+L)=0 L=L+8
210 IF L<128 GOTO 130
230 RETURN
REM ---- GENP: the piece Q on L
300 C=Q
310 IF Q>8 C=Q-8
320 IF C=1 GOTO 800
330 IF C=2 H=U+32
340 IF C=2 GOTO 600
350 IF C=6 H=U+24
360 IF C=6 GOTO 600
370 R=7
380 J=0
390 IF C=3 J=4
400 IF C=4 R=3
410 GOTO 700
REM ---- ADDMV: L to T unless T holds one of our own
500 G=PEEK(Z+T)
510 IF G=0 GOTO 540
520 IF G>8 IF S=8 RETURN
530 IF G<8 IF S=0 RETURN
540 POKE W,L
550 POKE W+1,T
560 W=W+2
570 RETURN
REM ---- GHOP: one step each way along the table at H
600 J=0
610 T=L+PEEK(H+J)-128
620 IF PEEK(U+128+T)=1 GOSUB 500
630 J=J+1
640 IF J<8 GOTO 610
650 RETURN
REM ---- GSLIDE: directions J..R until something is hit
700 O=PEEK(U+24+J)-128
710 T=L+O
720 IF PEEK(U+128+T)=0 GOTO 760
730 GOSUB 500
740 T=T+O
750 IF G=0 GOTO 720
760 J=J+1
770 IF J<=R GOTO 700
780 RETURN
REM ---- GPAWN
800 O=16
810 C=16
820 IF S=8 O=-16
830 IF S=8 C=96
840 T=L+O
850 IF PEEK(U+128+T)=0 GOTO 900
860 IF PEEK(Z+T)>0 GOTO 900
870 GOSUB 500
880 IF L<C GOTO 900
882 IF L>C+7 GOTO 900
885 T=T+O
890 IF PEEK(Z+T)=0 GOSUB 500
900 T=L+O-1
910 IF PEEK(U+128+T)=0 GOTO 930
920 IF PEEK(Z+T)>0 GOSUB 500
930 T=T+2
940 IF PEEK(U+128+T)=0 RETURN
950 IF PEEK(Z+T)>0 GOSUB 500
960 RETURN
REM ---- EVAL: material and position for white, into M
1500 M=0
1510 L=0
1520 Q=PEEK(Z+L)
1530 IF Q=0 GOTO 1640
1540 C=Q
1550 IF Q>8 C=Q-8
1560 H=U+C+C
1562 POKE 172,PEEK(H+1)
1564 POKE 173,PEEK(H)
1580 IF C=1 GOTO 1620
1590 IF C=6 GOTO 1630
1600 V=V+PEEK(U+320+L)
1610 GOTO 1630
1620 IF Q<8 V=V+PEEK(U+448+L)
1625 IF Q>8 V=V+PEEK(U+576+L)
1630 IF Q>8 V=-V
1635 M=M+V
1640 L=L+1
1650 IF PEEK(U+128+L)=0 L=L+8
1660 IF L<128 GOTO 1520
1670 RETURN
REM ---- SEARCH(P,S,D,A,B) into V, the list from K, the record at N
2000 IF D>0 GOTO 2030
2010 GOSUB 1500
2015 V=M
2020 IF S=8 V=-M
2025 RETURN
2030 GOSUB 100
2040 POKE N+6,PEEK(132)
2045 POKE N+7,PEEK(133)
2050 POKE N+12,PEEK(174)
2052 POKE N+13,PEEK(175)
2055 E=-30000
2060 M=K
2070 IF M>=W GOTO 2400
2090 F=PEEK(M)
2100 T=PEEK(M+1)
2120 POKE N+2,PEEK(Z+T)
2130 POKE Z+T,PEEK(Z+F)
2140 POKE Z+F,0
2150 POKE N+4,PEEK(130)
2160 POKE N+5,PEEK(131)
2190 POKE N+8,PEEK(138)
2200 POKE N+9,PEEK(139)
2210 POKE N,PEEK(154)
2215 POKE N+1,PEEK(155)
2220 P=P+1
2225 N=N+16
2230 S=8-S
2240 D=D-1
2245 K=W
2250 M=A
2255 A=-B
2260 B=-M
2265 GOSUB 2000
2270 P=P-1
2272 N=N-16
2275 S=8-S
2280 D=D+1
2285 V=-V
2292 POKE 130,PEEK(N+4)
2293 POKE 131,PEEK(N+5)
2294 POKE 132,PEEK(N+6)
2295 POKE 133,PEEK(N+7)
2296 POKE 138,PEEK(N+8)
2297 POKE 139,PEEK(N+9)
2298 POKE 154,PEEK(N)
2299 POKE 155,PEEK(N+1)
2300 POKE 174,PEEK(N+12)
2305 POKE 175,PEEK(N+13)
2320 F=PEEK(M)
2330 T=PEEK(M+1)
2340 POKE Z+F,PEEK(Z+T)
2350 POKE Z+T,PEEK(N+2)
2360 IF V>E E=V
2370 IF E>A A=E
2380 IF A>=B M=W
2390 M=M+2
2395 GOTO 2070
2400 V=E
2410 RETURN
REM ---- BESTMV(S,D): the best move's address into X+10, 0 for none
3000 P=0
3005 N=X
3010 K=Y
3015 GOSUB 100
3020 POKE N+12,PEEK(174)
3025 POKE N+13,PEEK(175)
3030 M=K
3045 E=-30000
3060 POKE N+10,0
3065 POKE N+11,0
3070 IF M>=W RETURN
3085 F=PEEK(M)
3090 T=PEEK(M+1)
3095 POKE N+2,PEEK(Z+T)
3100 POKE Z+T,PEEK(Z+F)
3105 POKE Z+F,0
3106 POKE N,PEEK(154)
3107 POKE N+1,PEEK(155)
3108 POKE N+8,PEEK(138)
3109 POKE N+9,PEEK(139)
3110 P=1
3112 N=N+16
3115 S=8-S
3120 D=D-1
3122 K=W
3125 A=-30000
3130 B=30000
3135 GOSUB 2000
3140 P=0
3142 N=N-16
3145 S=8-S
3150 D=D+1
3155 V=-V
3160 POKE 154,PEEK(N)
3165 POKE 155,PEEK(N+1)
3170 POKE 174,PEEK(N+12)
3172 POKE 175,PEEK(N+13)
3175 F=PEEK(M)
3180 T=PEEK(M+1)
3185 POKE Z+F,PEEK(Z+T)
3190 POKE Z+T,PEEK(N+2)
3195 POKE 138,PEEK(N+8)
3200 POKE 139,PEEK(N+9)
3205 IF V<=E GOTO 3230
3210 E=V
3215 POKE N+10,PEEK(154)
3220 POKE N+11,PEEK(155)
3230 M=M+2
3235 GOTO 3070
REM ---- SHOW: the board, rank 8 first
7000 R=7
7010 PLOT 49+R
7020 PLOT 32
7030 L=R*16
7040 Q=PEEK(Z+L)
7050 C=Q
7060 IF Q>8 C=Q-8
7070 C=PEEK(U+40+C)
7080 IF Q>8 C=C+32
7090 PLOT C
7100 PLOT 32
7110 L=L+1
7120 IF L<R*16+8 GOTO 7040
7130 PRINT
7140 R=R-1
7150 IF R>=0 GOTO 7010
7160 PRINT "  A B C D E F G H"
7170 RETURN
REM ---- SETUP: tables and the opening position
8000 POKE U+0,0
8005 POKE U+1,0
8010 POKE U+2,100
8015 POKE U+3,0
8020 POKE U+4,64
8025 POKE U+5,1
8030 POKE U+6,74
8035 POKE U+7,1
8040 POKE U+8,244
8045 POKE U+9,1
8050 POKE U+10,132
8055 POKE U+11,3
8060 POKE U+12,32
8065 POKE U+13,78
8070 POKE U+16,0
8075 POKE U+17,1
8080 POKE U+18,2
8085 POKE U+19,3
8090 POKE U+20,3
8095 POKE U+21,2
8100 POKE U+22,1
8105 POKE U+23,0
8110 POKE U+24,129
8115 POKE U+25,127
8120 POKE U+26,144
8125 POKE U+27,112
8130 POKE U+28,143
8135 POKE U+29,113
8140 POKE U+30,145
8145 POKE U+31,111
8150 POKE U+32,159
8155 POKE U+33,161
8160 POKE U+34,142
8165 POKE U+35,146
8170 POKE U+36,97
8175 POKE U+37,95
8180 POKE U+38,114
8185 POKE U+39,110
8190 POKE U+40,46
8195 POKE U+41,80
8200 POKE U+42,78
8205 POKE U+43,66
8210 POKE U+44,82
8215 POKE U+45,81
8220 POKE U+46,75
8300 T=-64
8310 POKE U+128+T,0
8320 IF T<0 GOTO 8350
8330 IF T>127 GOTO 8350
8340 IF T-T/16*16<8 POKE U+128+T,1
8350 T=T+1
8360 IF T<192 GOTO 8310
8370 L=0
8375 R=L/16
8380 F=L-R*16
8385 POKE U+320+L,(PEEK(U+16+F)+PEEK(U+16+R))*3
8390 POKE U+448+L,R*4
8392 POKE U+576+L,(7-R)*4
8394 L=L+1
8396 IF L<128 GOTO 8375
8400 L=0
8410 POKE Z+L,0
8420 L=L+1
8430 IF L<128 GOTO 8410
8500 L=0
8510 C=4
8520 IF L=1 C=2
8530 IF L=2 C=3
8540 IF L=3 C=5
8550 IF L=4 C=6
8560 IF L=5 C=3
8570 IF L=6 C=2
8580 POKE Z+L,C
8590 POKE Z+16+L,1
8600 POKE Z+96+L,9
8610 POKE Z+112+L,C+8
8620 L=L+1
8630 IF L<8 GOTO 8510
8640 RETURN
REM ---- main
9000 Z=24576
9010 Y=24832
9020 X=25600
9030 U=25856
9040 GOSUB 8000
9050 GOSUB 7000
9060 PRINT "THINKING"
9070 S=0
9080 D=2
9090 GOSUB 3000
9100 POKE 154,PEEK(X+10)
9110 POKE 155,PEEK(X+11)
9120 F=PEEK(M)
9130 T=PEEK(M+1)
9140 PLOT 97+F-F/16*16
9150 PLOT 49+F/16
9160 PLOT 97+T-T/16*16
9170 PLOT 49+T/16
9180 PRINT
9190 POKE Z+T,PEEK(Z+F)
9200 POKE Z+F,0
9210 GOSUB 7000
9220 PRINT "DONE"
9230 END
